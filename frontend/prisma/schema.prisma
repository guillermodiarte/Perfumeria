datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String // Stored as JSON string

  @@map("site_settings")
}

model Province {
  id     Int    @id @default(autoincrement())
  name   String @unique
  cities City[]

  @@map("provinces")
}

model City {
  id          Int       @id @default(autoincrement())
  province_id Int?
  name        String?
  postal_code String?
  province    Province? @relation(fields: [province_id], references: [id])

  @@index([name])
  @@index([province_id])
  @@map("cities")
}

model Customer {
  id                 Int         @id @default(autoincrement())
  email              String      @unique
  password_hash      String
  name               String
  phone              String      @unique
  address            String?
  province           String?
  city               String?
  postal_code        String?
  email_verified     Boolean?    @default(false)
  verification_token String?
  is_approved        Boolean?    @default(false)
  created_at         DateTime?   @default(now())
  is_wholesale       Boolean?    @default(false)
  wholesale_until    DateTime?
  cart_items         CartItem[]
  orders             Order[]

  @@map("customers")
}

model Admin {
  id            Int     @id @default(autoincrement())
  email         String  @unique
  password_hash String
  name          String
  role          String? @default("admin")

  @@map("admins")
}

model CartItem {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  product_id String
  variant_id String
  quantity   Int?      @default(1)
  customer   Customer? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("cart_items")
}

model Order {
  id                          Int         @id @default(autoincrement())
  order_number                String?     @unique
  user_id                     Int?
  status                      String?     @default("En revisión")
  total                       Float?      @default(0)
  created_at                  DateTime?   @default(now())
  payment_status              String?     @default("pending")
  paid_amount                 Float?      @default(0)
  admin_notes                 String?
  delivery_status             String?     @default("pending")
  payment_type                String?     @default("total")
  installments_count          Int?        @default(1)
  last_installment_paid_month String?
  shipping_type               String?     @default("delivery")
  shipping_cost               Float?      @default(0)
  shipping_tracking_number    String?
  shipping_invoice_url        String?
  shipped_at                  String?
  customer                    Customer?   @relation(fields: [user_id], references: [id])
  items                       OrderItem[]

  @@index([user_id])
  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  order_id     Int?
  product_id   String
  variant_id   String
  quantity     Int?    @default(1)
  price        Float?  @default(0)
  product_name String?
  variant_info String?
  image_url    String?
  order        Order?  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_items")
}

model Supplier {
  id               Int             @id @default(autoincrement())
  name             String          @unique
  created_at       DateTime?       @default(now())
  purchase_batches PurchaseBatch[]

  @@map("suppliers")
}

model PurchaseBatch {
  id                     Int                 @id @default(autoincrement())
  batch_number           String?             @unique
  supplier_id            Int?
  purchase_date          DateTime?
  currency               String?             @default("ARS")
  exchange_rate          Float?              @default(1.0)
  shipping_currency      String?             @default("ARS")
  shipping_cost_original Float?              @default(0.0)
  shipping_cost_ars      Float?              @default(0.0)
  total_products_ars     Float?              @default(0.0)
  total_cost_ars         Float?              @default(0.0)
  notes                  String?
  created_at             DateTime?           @default(now())
  supplier               Supplier?           @relation(fields: [supplier_id], references: [id])
  items                  PurchaseBatchItem[]

  @@index([supplier_id])
  @@map("purchase_batches")
}

model PurchaseBatchItem {
  id                      Int            @id @default(autoincrement())
  batch_id                Int
  product_id              String
  variant_id              String
  product_name            String?
  variant_label           String?
  quantity                Int?           @default(1)
  unit_cost_original      Float?         @default(0.0)
  unit_cost_ars           Float?         @default(0.0)
  shipping_per_unit_ars   Float?         @default(0.0)
  total_cost_per_unit_ars Float?         @default(0.0)
  sale_price              Float?         @default(0.0)
  batch                   PurchaseBatch  @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([batch_id])
  @@map("purchase_batch_items")
}

